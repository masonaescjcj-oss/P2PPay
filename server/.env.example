PORT=3000
# Platform USDT (TRC20) deposit address shown to users
DEPOSIT_ADDRESS=TYourTronDepositAddressHere000000
# Admin account created on startup
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please
# Trade fee in basis points (10 = 0.1%)
TRADE_FEE_BPS=10
# Withdrawal network fee and minimum, in micro-USDT (1 USDT = 1000000)
WITHDRAW_FEE_MICRO=1000000
MIN_WITHDRAW_MICRO=5000000
PAYMENT_WINDOW_MIN=30
# Set to 1 when served over HTTPS
COOKIE_SECURE=0

# ---- On-chain mode (TRON / USDT TRC20) ----
# off = manual mode (shared DEPOSIT_ADDRESS, admin records txids); nile = testnet; mainnet = real funds
TRON_NETWORK=off
# Required for mainnet, as an explicit confirmation
# TRON_MAINNET_CONFIRM=yes
# Free key from https://www.trongrid.io (raises rate limits)
TRONGRID_API_KEY=
# 24-word secret from `npm run wallet:new`. NEVER commit it; inject from a secret manager in production.
WALLET_MNEMONIC=
# Optional cold wallet: sweeps go here once the hot wallet holds more than HOT_WALLET_MAX_MICRO
COLD_WALLET_ADDRESS=
HOT_WALLET_MAX_MICRO=5000000000
# Withdrawals up to this amount are sent automatically (accounts older than 24h), within a daily cap
AUTO_WITHDRAW_MAX_MICRO=200000000
DAILY_AUTO_WITHDRAW_MAX_MICRO=2000000000
MIN_DEPOSIT_MICRO=1000000
# Sweep a deposit address once it holds this much; TRX top-up for its fees
SWEEP_MIN_MICRO=20000000
SWEEP_TOPUP_SUN=35000000
SWEEP_TRX_MIN_SUN=30000000
FEE_LIMIT_SUN=60000000
CHAIN_INTERVAL_MS=20000
