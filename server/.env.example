PORT=3000

# ---- Database (PostgreSQL / Supabase) ----
# Empty = embedded PGlite in ./data/pglite (development only).
# Supabase: Project Settings → Database → Connection string → "Session pooler" (port 5432) or direct.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
DATABASE_URL=
# Supabase CA certificate (Database settings → SSL) for verified TLS: a file path, or the PEM text in DATABASE_CA
DATABASE_CA_PATH=
DATABASE_CA=
DATABASE_POOL_SIZE=10
# Apply supabase/migrations on startup (Fly.io runs them as release_command and sets this to 0)
MIGRATE_ON_START=1
# Behind a proxy: number of trusted hops for the client IP (Fly.io: 1)
TRUST_PROXY=loopback
# Platform USDT (TRC20) deposit address shown to users
DEPOSIT_ADDRESS=TYourTronDepositAddressHere000000
# Admin account created on startup
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please
# Trade fee in basis points (10 = 0.1%)
TRADE_FEE_BPS=10
# Withdrawal network fee and minimum, in micro-USDT (1 USDT = 1000000)
WITHDRAW_FEE_MICRO=1000000
MIN_WITHDRAW_MICRO=5000000
PAYMENT_WINDOW_MIN=30
# Set to 1 when served over HTTPS
COOKIE_SECURE=0

# ---- On-chain mode (TRON / USDT TRC20) ----
# off = manual mode (shared DEPOSIT_ADDRESS, admin records txids); nile = testnet; mainnet = real funds
TRON_NETWORK=off
# Required for mainnet, as an explicit confirmation
# TRON_MAINNET_CONFIRM=yes
# Free key from https://www.trongrid.io (raises rate limits)
TRONGRID_API_KEY=
# 24-word secret from `npm run wallet:new`. NEVER commit it; inject from a secret manager in production.
WALLET_MNEMONIC=
# Optional cold wallet: sweeps go here once the hot wallet holds more than HOT_WALLET_MAX_MICRO
COLD_WALLET_ADDRESS=
HOT_WALLET_MAX_MICRO=5000000000
# Withdrawals up to this amount are sent automatically (accounts older than 24h), within a daily cap
AUTO_WITHDRAW_MAX_MICRO=200000000
DAILY_AUTO_WITHDRAW_MAX_MICRO=2000000000
MIN_DEPOSIT_MICRO=1000000
# Sweep a deposit address once it holds this much; TRX top-up for its fees
SWEEP_MIN_MICRO=20000000
SWEEP_TOPUP_SUN=35000000
SWEEP_TRX_MIN_SUN=30000000
FEE_LIMIT_SUN=60000000
CHAIN_INTERVAL_MS=20000

# ---- Security & compliance ----
NODE_ENV=development
# 64 hex chars; encrypts TOTP secrets and KYC documents. REQUIRED in production. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Losing it makes stored KYC documents and 2FA secrets unreadable — back it up like the wallet mnemonic.
DATA_ENCRYPTION_KEY=
# KYC documents (encrypted before upload): local = KYC_DIR; supabase = a PRIVATE Storage bucket
STORAGE_PROVIDER=local
KYC_DIR=./data/kyc
SUPABASE_URL=
# Server-side secret; never expose it to the browser
SUPABASE_SERVICE_ROLE_KEY=
KYC_BUCKET=kyc
# console (development: codes printed in the server log) or twilio
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Staff (admin/finance/support) must have an authenticator app enabled to use the admin panel
REQUIRE_STAFF_2FA=1
# Rolling 24h trade and withdrawal limits per KYC tier (micro-USDT)
LIMIT_TIER1_MICRO=1000000000
LIMIT_TIER2_MICRO=20000000000
LIMIT_TIER3_MICRO=200000000000
ALERT_LARGE_TRADE_MICRO=5000000000

# ---- Closed beta (see BETA.md) ----
# 1 = sign-up only with an invite code (staff create codes in Admin → Beta → Invites)
BETA_INVITE_ONLY=0
# Caps per trade and per offer in micro-USDT; 0 = no cap (100000000 = 100 USDT)
BETA_MAX_TRADE_MICRO=0
BETA_MAX_OFFER_MICRO=0
# Optional text for the beta note on the home screen (default: "test version — try with small amounts")
BETA_LABEL=
